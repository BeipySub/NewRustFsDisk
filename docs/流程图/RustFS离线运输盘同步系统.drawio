                </mxCell>
                <mxCell id="a4" value="否" style="endArrow=classic;html=1;strokeWidth=2;" parent="1" source="check1" target="reject" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="a5" value="是" style="endArrow=classic;html=1;strokeWidth=2;" parent="1" source="check1" target="step3" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="a6" value="" style="endArrow=classic;html=1;strokeWidth=2;" parent="1" source="step3" target="step4" edge="1">
