    <diagram id="disk-structure" name="02-运输盘结构">
        <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="t" value="运输硬盘目录与 disk_info.json 结构" style="text;html=1;align=center;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#1F2937;" parent="1" vertex="1">
                    <mxGeometry x="400" y="20" width="800" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="tree" value="rustfs-transport/&#xa;├── disk_info.json&#xa;├── manifest.zip&#xa;└── data/&#xa;    └── {来源桶名}/&#xa;        └── {来源目录}/&#xa;            └── {原对象名}.zip" style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF7E6;strokeColor=#F59E0B;fontFamily=Courier New;fontSize=17;align=left;spacingLeft=14;" parent="1" vertex="1">
                    <mxGeometry x="40" y="110" width="480" height="400" as="geometry"/>
                </mxCell>
                <mxCell id="info" value="disk_info.json（明文）&#xa;&#xa;state: READY / WRITING / SEALED&#xa;disk.disk_id: 本次运输 UUID&#xa;disk.initialized_at&#xa;&#xa;edge:&#xa;  edge_name&#xa;  edge_code&#xa;  export_started_at（只首次写入）&#xa;  export_finished_at&#xa;  manifest_sha256&#xa;  object_count" style="shape=note;whiteSpace=wrap;html=1;fillColor=#E8F1FF;strokeColor=#2563EB;fontFamily=Courier New;fontSize=14;align=left;spacingLeft=14;" parent="1" vertex="1">
                    <mxGeometry x="650" y="110" width="400" height="400" as="geometry"/>
                </mxCell>
                <mxCell id="crypto" value="ZIP 加密规则&#xa;&#xa;算法：ZipCrypto&#xa;密码：日期(YYYY-MM-DD) + edge_code + key&#xa;日期来源：edge.export_started_at&#xa;对象 ZIP 与 manifest.zip 均加密&#xa;disk_info.json 不加密" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontSize=16;align=left;spacingLeft=16;" parent="1" vertex="1">
                    <mxGeometry x="1120" y="200" width="360" height="220" as="geometry"/>
                </mxCell>
                <mxCell id="manifest" value="manifest.zip 内部：manifest.jsonl&#xa;&#xa;每行对象：&#xa;source_bucket / source_key&#xa;etag / size / plain_sha256&#xa;zip_path" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#16A34A;fontSize=15;align=left;spacingLeft=16;" parent="1" vertex="1">
                    <mxGeometry x="100" y="640" width="360" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="arrow1" value="" style="endArrow=classic;html=1;strokeColor=#6B7280;" parent="1" source="tree" target="info" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="arrow2" value="" style="endArrow=classic;html=1;strokeColor=#6B7280;" parent="1" source="info" target="crypto" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="arrow3" value="" style="endArrow=classic;html=1;strokeColor=#6B7280;" parent="1" source="tree" target="manifest" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="edge-flow" name="03-Edge导出流程">
        <mxGraphModel dx="907" dy="646" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="1500" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title" value="Edge 自动导出与封盘流程" style="text;html=1;align=center;verticalAlign=middle;fontSize=25;fontStyle=1;fontColor=#1F2937;" parent="1" vertex="1">
                    <mxGeometry x="250" y="25" width="700" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="start" value="发现运输盘" style="ellipse;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;fontSize=16;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="475" y="100" width="250" height="52" as="geometry"/>
                </mxCell>
                <mxCell id="step1" value="自动挂载，读取 disk_info.json" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;fontSize=16;" parent="1" vertex="1">
                    <mxGeometry x="350" y="195" width="500" height="62" as="geometry"/>
                </mxCell>
                <mxCell id="check1" value="可用于本 Edge 导出？&#xa;READY，或同 edge_code 的 WRITING" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;fontSize=15;" parent="1" vertex="1">
                    <mxGeometry x="500" y="305" width="200" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="ignore" value="SEALED 或其他站点 WRITING&#xa;仅展示，不写入" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#6B7280;fontSize=14;" parent="1" vertex="1">
                    <mxGeometry x="825" y="330" width="240" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="step2" value="S3 分页扫描&#xa;跳过 CONFIRMED 和当前盘 WRITTEN 对象" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;fontSize=16;" parent="1" vertex="1">
                    <mxGeometry x="350" y="465" width="500" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="check2" value="有待导出对象？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;fontSize=15;" parent="1" vertex="1">
                    <mxGeometry x="500" y="585" width="200" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="noobj" value="删除待导出任务&#xa;保持 READY，不封盘" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#6B7280;fontSize=14;" parent="1" vertex="1">
                    <mxGeometry x="825" y="605" width="240" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="step3" value="READY：首次写入 Edge 信息，转为 WRITING&#xa;WRITING：盘与 Edge 运行时账本对账后恢复" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BFDBFE;strokeColor=#1D4ED8;fontSize=16;" parent="1" vertex="1">
                    <mxGeometry x="350" y="735" width="500" height="72" as="geometry"/>
                </mxCell>
                <mxCell id="step4" value="逐对象写入&#xa;空间判断 → ZipCrypto ZIP → ETag/大小复核 → 账本记录 WRITTEN" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;fontSize=16;" parent="1" vertex="1">
                    <mxGeometry x="350" y="855" width="500" height="72" as="geometry"/>
                </mxCell>
                <mxCell id="step5" value="当前对象放不下，或待导出对象全部完成" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontSize=16;" parent="1" vertex="1">
                    <mxGeometry x="350" y="975" width="500" height="62" as="geometry"/>
                </mxCell>
                <mxCell id="step6" value="封盘&#xa;生成 manifest.zip 与 SHA256；最后将 disk_info.json.state 写为 SEALED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontSize=16;" parent="1" vertex="1">
                    <mxGeometry x="350" y="1085" width="500" height="72" as="geometry"/>
                </mxCell>
                <mxCell id="done" value="当前盘 WRITTEN → CONFIRMED&#xa;导出任务：已封盘" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontSize=16;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="350" y="1205" width="500" height="62" as="geometry"/>
                </mxCell>
                <mxCell id="exception" value="异常处理&#xa;拔盘：任务为“等待恢复”，同 disk_id 重新插入后恢复。&#xa;读取或写入失败：任务为“导出失败”，硬盘仍在时 60 秒后自动重试。" style="shape=note;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#DC2626;fontSize=14;align=left;spacingLeft=12;" parent="1" vertex="1">
                    <mxGeometry x="880" y="820" width="260" height="145" as="geometry"/>
                </mxCell>
                <mxCell id="a1" value="" style="endArrow=classic;html=1;strokeWidth=2;" parent="1" source="start" target="step1" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="a2" value="" style="endArrow=classic;html=1;strokeWidth=2;" parent="1" source="step1" target="check1" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="a3" value="否" style="endArrow=classic;html=1;strokeWidth=2;" parent="1" source="check1" target="ignore" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="a4" value="是" style="endArrow=classic;html=1;strokeWidth=2;" parent="1" source="check1" target="step2" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="a5" value="" style="endArrow=classic;html=1;strokeWidth=2;" parent="1" source="step2" target="check2" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="a6" value="否" style="endArrow=classic;html=1;strokeWidth=2;" parent="1" source="check2" target="noobj" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="a7" value="是" style="endArrow=classic;html=1;strokeWidth=2;" parent="1" source="check2" target="step3" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="a8" value="" style="endArrow=classic;html=1;strokeWidth=2;" parent="1" source="step3" target="step4" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="a9" value="" style="endArrow=classic;html=1;strokeWidth=2;" parent="1" source="step4" target="step5" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="a10" value="" style="endArrow=classic;html=1;strokeWidth=2;" parent="1" source="step5" target="step6" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="a11" value="" style="endArrow=classic;html=1;strokeWidth=2;" parent="1" source="step6" target="done" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="a12" value="" style="dashed=1;endArrow=none;html=1;strokeColor=#DC2626;" parent="1" source="step4" target="exception" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="center-flow" name="04-Center导入流程">
        <mxGraphModel dx="907" dy="646" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="1450" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title" value="Center 自动导入与重新初始化流程" style="text;html=1;align=center;verticalAlign=middle;fontSize=25;fontStyle=1;fontColor=#1F2937;" parent="1" vertex="1">
                    <mxGeometry x="250" y="25" width="700" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="start" value="发现运输盘" style="ellipse;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontSize=16;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="475" y="100" width="250" height="52" as="geometry"/>
                </mxCell>
                <mxCell id="step1" value="自动挂载，读取 disk_info.json&#xa;仅 SEALED 盘进入导入队列" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#16A34A;fontSize=16;" parent="1" vertex="1">
                    <mxGeometry x="350" y="195" width="500" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="step2" value="创建或读取 import_tasks&#xa;多块盘按 queued_at 从早到晚串行导入" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontSize=16;" parent="1" vertex="1">
                    <mxGeometry x="350" y="315" width="500" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="check1" value="disk_id 为 FREE&#xa;且 Edge 站点与 Key 均存在？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#16A34A;fontSize=15;" parent="1" vertex="1">
                    <mxGeometry x="500" y="435" width="200" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="reject" value="拒绝导入&#xa;保留 SEALED 盘，显示原因" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontSize=14;" parent="1" vertex="1">
                    <mxGeometry x="825" y="460" width="240" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="step3" value="校验 manifest.zip SHA256&#xa;按密码流式解压并读取 manifest.jsonl" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontSize=16;" parent="1" vertex="1">
                    <mxGeometry x="350" y="595" width="500" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="step4" value="逐条清单导入&#xa;对象账本去重 → 解压 ZIP → SHA256 校验 → 写入 Center RustFS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#16A34A;fontSize=16;" parent="1" vertex="1">
                    <mxGeometry x="350" y="715" width="500" height="72" as="geometry"/>
                </mxCell>
                <mxCell id="step5" value="每个成功对象写入 import_objects&#xa;更新任务的数量、源文件数据量和实时进度" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontSize=16;" parent="1" vertex="1">
                    <mxGeometry x="350" y="835" width="500" height="72" as="geometry"/>
                </mxCell>
                <mxCell id="step6" value="所有对象已成功导入&#xa;任务状态为“导入成功”，旧 disk_id 更新为 USED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBF7D0;strokeColor=#15803D;fontSize=16;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="350" y="955" width="500" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="step7" value="自动重新初始化运输盘&#xa;清理盘内数据，生成新的 disk_id；新记录为 FREE，盘状态为 READY" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontSize=16;" parent="1" vertex="1">
                    <mxGeometry x="350" y="1075" width="500" height="72" as="geometry"/>
                </mxCell>
                <mxCell id="done" value="可再次交给 Edge 导出" style="ellipse;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#6B7280;fontSize=16;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="475" y="1200" width="250" height="52" as="geometry"/>
                </mxCell>
                <mxCell id="exception" value="失败与重试&#xa;manifest、密码、ZIP、校验或 RustFS 写入失败：&#xa;任务为“导入失败”，盘保持 SEALED；60 秒后自动重试。" style="shape=note;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#DC2626;fontSize=14;align=left;spacingLeft=12;" parent="1" vertex="1">
                    <mxGeometry x="880" y="715" width="260" height="135" as="geometry"/>
                </mxCell>
                <mxCell id="a1" value="" style="endArrow=classic;html=1;strokeWidth=2;" parent="1" source="start" target="step1" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
