                <mxCell id="a7" value="" style="endArrow=classic;html=1;" parent="1" source="ready" target="n3" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="a8" value="" style="endArrow=classic;html=1;" parent="1" source="n3" target="d2" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="a9" value="否" style="endArrow=classic;html=1;" parent="1" source="d2" target="noobj" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
