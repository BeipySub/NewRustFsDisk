    <diagram id="disk-structure" name="02-运输盘结构">
        <mxGraphModel dx="907" dy="646" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="t" value="运输硬盘目录与 disk_info.json 结构" style="text;html=1;align=center;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#1F2937;" parent="1" vertex="1">
                    <mxGeometry x="400" y="20" width="800" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="tree" value="rustfs-transport/&#xa;├── disk_info.json&#xa;├── manifest.zip&#xa;└── data/&#xa;    └── {来源桶名}/&#xa;        └── {来源目录}/&#xa;            └── {原对象名}.zip" style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF7E6;strokeColor=#F59E0B;fontFamily=Courier New;fontSize=17;align=left;spacingLeft=14;" parent="1" vertex="1">
                    <mxGeometry x="80" y="110" width="480" height="400" as="geometry"/>
                </mxCell>
                <mxCell id="info" value="disk_info.json（明文）&#xa;&#xa;state: READY / WRITING / SEALED&#xa;disk.disk_id: 本次运输 UUID&#xa;disk.initialized_at&#xa;&#xa;edge:&#xa;  edge_name&#xa;  edge_code&#xa;  export_started_at（只首次写入）&#xa;  export_finished_at&#xa;  manifest_sha256&#xa;  object_count" style="shape=note;whiteSpace=wrap;html=1;fillColor=#E8F1FF;strokeColor=#2563EB;fontFamily=Courier New;fontSize=14;align=left;spacingLeft=14;" parent="1" vertex="1">
                    <mxGeometry x="650" y="110" width="400" height="400" as="geometry"/>
                </mxCell>
                <mxCell id="crypto" value="ZIP 加密规则&#xa;&#xa;算法：ZipCrypto&#xa;密码：日期(YYYY-MM-DD) + edge_code + key&#xa;日期来源：edge.export_started_at&#xa;对象 ZIP 与 manifest.zip 均加密&#xa;disk_info.json 不加密" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontSize=16;align=left;spacingLeft=16;" parent="1" vertex="1">
                    <mxGeometry x="1110" y="150" width="360" height="220" as="geometry"/>
                </mxCell>
                <mxCell id="manifest" value="manifest.zip 内部：manifest.jsonl&#xa;&#xa;每行对象：&#xa;source_bucket / source_key&#xa;etag / size / plain_sha256&#xa;zip_path" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#16A34A;fontSize=15;align=left;spacingLeft=16;" parent="1" vertex="1">
                    <mxGeometry x="1110" y="410" width="360" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="arrow1" value="" style="endArrow=classic;html=1;strokeColor=#6B7280;" parent="1" source="tree" target="info" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="arrow2" value="" style="endArrow=classic;html=1;strokeColor=#6B7280;" parent="1" source="info" target="crypto" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="arrow3" value="" style="endArrow=classic;html=1;strokeColor=#6B7280;" parent="1" source="tree" target="manifest" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="edge-flow" name="03-Edge导出流程">
        <mxGraphModel dx="907" dy="646" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="t" value="Edge 自动导出与封盘流程" style="text;html=1;align=center;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#1F2937;" parent="1" vertex="1">
                    <mxGeometry x="400" y="20" width="800" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="n1" value="扫描并自动挂载运输盘" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;fontSize=15;" parent="1" vertex="1">
                    <mxGeometry x="70" y="150" width="170" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="n2" value="读取 disk_info.json" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;fontSize=15;" parent="1" vertex="1">
                    <mxGeometry x="290" y="150" width="170" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="d1" value="状态？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;fontSize=15;" parent="1" vertex="1">
                    <mxGeometry x="520" y="140" width="100" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="sealed" value="SEALED&#xa;仅展示，不写入" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#6B7280;fontSize=14;" parent="1" vertex="1">
                    <mxGeometry x="670" y="80" width="170" height="55" as="geometry"/>
                </mxCell>
                <mxCell id="writing" value="WRITING&#xa;仅同 edge_code 可恢复&#xa;盘与账本对账" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0E7FF;strokeColor=#4F46E5;fontSize=14;" parent="1" vertex="1">
                    <mxGeometry x="670" y="160" width="170" height="75" as="geometry"/>
                </mxCell>
                <mxCell id="ready" value="READY&#xa;进入导出队列" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0E7FF;strokeColor=#4F46E5;fontSize=14;" parent="1" vertex="1">
                    <mxGeometry x="670" y="270" width="170" height="55" as="geometry"/>
                </mxCell>
                <mxCell id="n3" value="S3 分页扫描&#xa;跳过 CONFIRMED 与当前 WRITTEN" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BFDBFE;strokeColor=#1D4ED8;fontSize=14;" parent="1" vertex="1">
                    <mxGeometry x="900" y="260" width="205" height="65" as="geometry"/>
                </mxCell>
                <mxCell id="d2" value="有待导出对象？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;fontSize=14;" parent="1" vertex="1">
                    <mxGeometry x="1160" y="250" width="115" height="85" as="geometry"/>
                </mxCell>
                <mxCell id="noobj" value="删除待导出任务&#xa;保持 READY，不封盘" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#6B7280;fontSize=14;" parent="1" vertex="1">
                    <mxGeometry x="1330" y="170" width="175" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="n4" value="READY：首次写入 Edge 信息并转 WRITING&#xa;WRITING：保留原 Edge 信息" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BFDBFE;strokeColor=#1D4ED8;fontSize=14;" parent="1" vertex="1">
                    <mxGeometry x="900" y="390" width="260" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="n5" value="逐对象：空间判断 → 加密 ZIP → ETag/大小复核 → 账本 WRITTEN" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;fontSize=14;" parent="1" vertex="1">
                    <mxGeometry x="900" y="500" width="320" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="d3" value="拔盘 / 读取失败？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;fontSize=14;" parent="1" vertex="1">
                    <mxGeometry x="1280" y="490" width="115" height="85" as="geometry"/>
                </mxCell>
                <mxCell id="retry" value="等待恢复 / 导出失败&#xa;60 秒后自动恢复或重试" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontSize=14;" parent="1" vertex="1">
                    <mxGeometry x="1430" y="500" width="160" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="n6" value="当前对象放不下&#xa;或待导出对象完成" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontSize=14;" parent="1" vertex="1">
                    <mxGeometry x="900" y="630" width="180" height="55" as="geometry"/>
                </mxCell>
                <mxCell id="n7" value="生成 manifest.zip + SHA256&#xa;写封盘信息，最后 state = SEALED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontSize=14;" parent="1" vertex="1">
                    <mxGeometry x="1130" y="630" width="240" height="55" as="geometry"/>
                </mxCell>
                <mxCell id="n8" value="当前盘 WRITTEN → CONFIRMED&#xa;任务：已封盘" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontSize=14;" parent="1" vertex="1">
                    <mxGeometry x="1420" y="630" width="165" height="55" as="geometry"/>
                </mxCell>
                <mxCell id="a1" value="" style="endArrow=classic;html=1;" parent="1" source="n1" target="n2" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="a2" value="" style="endArrow=classic;html=1;" parent="1" source="n2" target="d1" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="a3" value="SEALED" style="endArrow=classic;html=1;" parent="1" source="d1" target="sealed" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="a4" value="WRITING" style="endArrow=classic;html=1;" parent="1" source="d1" target="writing" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="a5" value="READY" style="endArrow=classic;html=1;" parent="1" source="d1" target="ready" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="a6" value="" style="endArrow=classic;html=1;" parent="1" source="writing" target="n3" edge="1">
